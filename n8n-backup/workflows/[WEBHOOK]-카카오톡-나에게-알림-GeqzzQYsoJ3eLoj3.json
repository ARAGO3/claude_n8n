      "id": "n4",
      "name": "메시지 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        300
      ],
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst text = String(body.message || '알림이 도착했습니다.').slice(0, 200);\nconst link = body.link || 'https://n8n.io';\nreturn [{ json: { template_object: JSON.stringify({ object_type: 'text', text, link: { web_url: link, mobile_web_url: link } }) } }];"
      }
    },
    {
      "id": "n5",
      "name": "나에게 보내기",
      "type": "n8n-nodes-base.httpRequest",
