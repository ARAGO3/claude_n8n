    {
      "id": "g2",
      "name": "전체 워크플로우 조회",
      "notes": "n8n API credential(n8nApi) 연결 필요: Base URL http://localhost:5678/api/v1 + API Key",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        560,
        304
      ],
      "parameters": {
        "resource": "workflow",
        "operation": "getAll",
        "returnAll": true,
        "filters": {},
        "requestOptions": {}
      },
