    {
      "id": "b7",
      "name": "상장 판정·메시지",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2050,
        300
      ],
      "parameters": {
        "jsCode": "const ctx = $('등록 종목 정리').first().json;\nconst cands = $('상세 대상 선정').all().map((i) => i.json);\nif (cands.length === 1 && cands[0].empty) return [];\nconst link = 'https://www.38.co.kr/html/fund/index.htm?o=k';\nconst num = (s) => (s == null ? null : parseFloat(String(s).replace(/,/g, '')));\nconst lines = [];\nfor (let i = 0; i < cands.length; i++) {\n  const c = cands[i];\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const t = new TextDecoder('euc-kr').decode(buf)\n    .replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/g, '')\n    .replace(/<[^>]+>/g, '|').replace(/&nbsp;/g, ' ').replace(/[\\s|]+/g, ' ');\n  const lm = t.match(/신규상장일 (\\d{4})\\.(\\d{2})\\.(\\d{2})/) || t.match(/상장일 (\\d{4})\\.(\\d{2})\\.(\\d{2})/);\n  if (!lm) continue;\n  const ln = +lm[1] * 10000 + +lm[2] * 100 + +lm[3];\n  if (ln !== ctx.today) continue;\n  const fm = t.match(/확정공모가 ([\\d,]+) 원/);\n  const price = c.row.price || (fm ? num(fm[1]) : null);\n  const priceTxt = price ? `${price.toLocaleString('en-US')}원` : '공모가 확인불가';\n  const sharesTxt = c.row.shares != null ? `배정 ${c.row.shares}주` : '배정수량 미확인';\n  const broker = c.row.broker || c.listBroker || '증권사 미확인';\n  const day = `${lm[2]}/${lm[3]}`;\n  if (ctx.mode === 'ready') {\n    lines.push([`📅 [상장 준비] 오늘 신규상장 ${c.name}`, `상장일 ${day} · 공모가 ${priceTxt}`, `${sharesTxt} · ${broker}`, '상장 당일 매도 계획을 확인하세요.'].join('\\n'));\n  } else {\n    lines.push([`🚨 오전 9시 거래 시작까지 약 3분! 증권사 앱을 확인하세요.`, `${c.name} · 공모가 ${priceTxt}`, `${sharesTxt} · ${broker}`].join('\\n'));\n  }\n}\nreturn lines.map((text) => ({ json: { template_object: JSON.stringify({ object_type: 'text', text, link: { web_url: link, mobile_web_url: link } }) } }));\n"
      }
    },
