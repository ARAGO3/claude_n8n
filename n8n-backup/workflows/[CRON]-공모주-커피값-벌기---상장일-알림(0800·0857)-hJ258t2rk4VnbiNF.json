    {
      "id": "b5",
      "name": "상세 대상 선정",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1550,
        300
      ],
      "parameters": {
        "jsCode": "const ctx = $('등록 종목 정리').first().json;\nconst listUrl = 'http://www.38.co.kr/html/fund/index.htm?o=k';\nif (!ctx.rows.length) return [{ json: { empty: true, url: listUrl } }];\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst html = new TextDecoder('euc-kr').decode(buf);\nconst strip = (s) => s.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\nconst out = [];\nfor (const tr of html.match(/<tr[^>]*>[\\s\\S]*?<\\/tr>/g) || []) {\n  const link = tr.match(/o=v&amp;no=(\\d+)/);\n  if (!link) continue;\n  const td = (tr.match(/<td[^>]*>[\\s\\S]*?<\\/td>/g) || []).map(strip);\n  const row = ctx.rows.find((r) => r.name === td[0]);\n  if (!row) continue;\n  out.push({ json: { no: link[1], name: td[0], listBroker: td[5], row, url: `http://www.38.co.kr/html/fund/?o=v&no=${link[1]}` } });\n}\nreturn out.length ? out : [{ json: { empty: true, url: listUrl } }];\n"
      }
    },
    {
      "id": "b6",
      "name": "상세 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "position": [
        1800,
