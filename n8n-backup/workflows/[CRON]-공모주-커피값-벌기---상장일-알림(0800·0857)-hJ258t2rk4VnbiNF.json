    {
      "id": "b3",
      "name": "등록 종목 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "jsCode": "const ctx = $('모드 결정').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.name && r.status !== 'ignore' && r.status !== '매도완료');\nreturn [{ json: { ...ctx, rows: rows.map((r) => ({ name: r.name, broker: r.broker || '', shares: r.shares ?? null, price: r.price ?? null })) } }];\n"
      }
    },
    {
      "id": "b4",
      "name": "38 목록 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://www.38.co.kr/html/fund/index.htm?o=k",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0"
            }
          ]
        },
