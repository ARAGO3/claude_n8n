    {
      "id": "b1",
      "name": "모드 결정",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        300
      ],
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst body = first.body || {};\nconst kst = new Date(Date.now() + 9 * 3600 * 1000);\nlet mode = body.mode;\nif (!mode) {\n  const mins = kst.getUTCHours() * 60 + kst.getUTCMinutes();\n  mode = mins < 510 ? 'ready' : 'now';\n}\nlet d = kst;\nif (body.today) {\n  const s = String(body.today).replace(/\\D/g, '');\n  d = new Date(Date.UTC(+s.slice(0, 4), +s.slice(4, 6) - 1, +s.slice(6, 8)));\n}\nconst today = d.getUTCFullYear() * 10000 + (d.getUTCMonth() + 1) * 100 + d.getUTCDate();\nreturn [{ json: { mode, today, dry: !!body.dry_run } }];\n"
      }
    },
    {
      "id": "b2",
      "name": "청약 종목 조회",
      "notes": "내가 실제 청약한 종목(ipo_subscriptions)",
      "type": "n8n-nodes-base.dataTable",
