    {
      "id": "m3",
      "name": "순위·곡·가수·좋아요 추출",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        304
      ],
      "parameters": {
        "jsCode": "const md = $input.first().json.data?.markdown || $input.first().json.markdown || '';\nconst now = new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Seoul' });\nconst rows = [];\nfor (const line of md.split('\\n')) {\n  const c = line.split('|');\n  const m = (c[2] || '').match(/^\\s*(\\d+)위\\s*$/);\n  if (!m) continue;\n  const parts = (c[6] || '').split('<br>');\n  const names = [...(parts[1] || '').matchAll(/\\[([^\\]]+)\\]\\(/g)].map(x => x[1]);\n  const lm = (c[8] || '').match(/([\\d,]+)\\s*$/);\n  rows.push({ json: {\n    '순위': Number(m[1]),\n    '곡제목': parts[0].trim(),\n    '가수': [...new Set(names)].join(', '),\n    '좋아요수': lm ? Number(lm[1].replace(/,/g, '')) : null,\n    '수집일시': now\n  } });\n}\nif (!rows.length) throw new Error('차트 데이터를 찾지 못했습니다. 크롤링 결과를 확인하세요.');\nreturn rows;"
      }
    },
