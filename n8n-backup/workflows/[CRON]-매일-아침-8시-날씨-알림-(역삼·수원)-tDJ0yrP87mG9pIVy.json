    {
      "id": "n3",
      "name": "메시지 만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const names = ['서울 역삼', '경기 수원'];\nconst wmo = (c) => {\n  if (c === 0) return '☀️ 맑음';\n  if (c <= 2) return '⛅ 구름 조금';\n  if (c === 3) return '☁️ 흐림';\n  if (c === 45 || c === 48) return '🌫️ 안개';\n  if (c >= 51 && c <= 57) return '🌦️ 이슬비';\n  if (c >= 61 && c <= 67) return '🌧️ 비';\n  if (c >= 71 && c <= 77) return '❄️ 눈';\n  if (c >= 80 && c <= 82) return '🌧️ 소나기';\n  if (c === 85 || c === 86) return '❄️ 눈보라';\n  if (c >= 95) return '⛈️ 뇌우';\n  return '🌡️ 알 수 없음';\n};\nconst items = $input.all();\nconst date = items[0].json.daily.time[0].slice(5).replace('-', '/');\nconst lines = items.map((it, i) => {\n  const d = it.json;\n  return `📍 ${names[i]}: ${wmo(d.current.weather_code)} | 현재 ${Math.round(d.current.temperature_2m)}°C | 최저 ${Math.round(d.daily.temperature_2m_min[0])}° / 최고 ${Math.round(d.daily.temperature_2m_max[0])}° | 강수확률 ${d.daily.precipitation_probability_max[0]}%`;\n});\nreturn [{ json: { text: `🌤️ 오늘의 날씨 (${date})\\n` + lines.join('\\n') } }];"
      }
    },
