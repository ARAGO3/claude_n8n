    {
      "id": "t2",
      "name": "할일 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst content = String(body.content || '').trim().slice(0, 1000);\nif (!content) throw new Error('content(할일 내용)가 필요합니다.');\nconst task = { content };\nif (body.due_date) {\n  const kst = new Date(Date.now() + 9 * 3600 * 1000);\n  const digits = String(body.due_date).replace(/\\D/g, '');\n  let ymd;\n  if (digits.length === 8) ymd = digits;\n  else if (digits.length === 4) ymd = `${kst.getUTCFullYear()}${digits}`; // MMDD\n  else throw new Error('due_date는 YYYY-MM-DD 또는 MMDD 형식이어야 합니다.');\n  task.due_info = { due_date: ymd, time_zone: 'Asia/Seoul' };\n  if (body.alarm_time) task.due_info.alarm_time = String(body.alarm_time).replace(/\\D/g, '').padStart(4, '0');\n}\nreturn [{ json: { task: JSON.stringify(task) } }];"
      }
    },
    {
      "id": "t3",
      "name": "할일 등록",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
